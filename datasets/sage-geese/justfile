import "../../common.just"

export CPL_VSIL_USE_TEMP_FILE_FOR_RANDOM_WRITE := "YES"
export AWS_VIRTUAL_HOSTING := "FALSE"


dataset := "pm25_exposure.tif"
raw := bucket / "sage-geese/raw" / dataset
out := bucket / "sage-geese" / file_stem(dataset)

[default]
all: \
    (virtual-zarr "512" "ZSTD") \
    (zarr "2048" "512" "BLOSC")

cog blocksize compress: (cog-gdal f"{{ raw }}" f"{{ out }}/COG-{{ blocksize }}-{{ compress }}.tif" blocksize compress)

zarr blocksize chunksize compress: (zarr-gdal f"{{ raw }}" f"{{ out }}/ZARR-{{ blocksize }}-{{ chunksize }}-{{ compress }}.zarr" blocksize chunksize compress)

virtual-zarr blocksize compress: (cog blocksize compress)
    python {{ scripts }}/tiff_to_virtual_zarr.py \
     "{{ out }}/COG-{{ blocksize }}-{{ compress }}.tif" \
      --json "{{ out }}/COG-{{ blocksize }}-{{ compress }}-refs.json" \
      --parquet "{{ out }}/COG-{{ blocksize }}-{{ compress }}-refs.parquet" \
      --icechunk "{{ out }}/COG-{{ blocksize }}-{{ compress }}-icechunk" \
      --message "data for COG-{{ blocksize }}-{{ compress }}" \
      {{ overwrite }}

cog-gdal src dst blocksize compress:
    {{ skip }} "{{ dst }}" || gdal raster translate \
        --output-format COG \
        --overwrite \
        --co BLOCKSIZE="{{ blocksize }}" \
        --co COMPRESS="{{ compress }}" \
        "{{ replace(src, 's3://', '/vsis3/') }}" \
        "{{ replace(dst, 's3://', '/vsis3/') }}"

zarr-gdal src dst blocksize chunksize compress:
    {{ skip }} "{{ dst }}" \
        || gdal raster translate \
            --output-format ZARR \
            --overwrite \
            --co FORMAT=ZARR_V3 \
            --co CREATE_CONSOLIDATED_METADATA=YES \
            --co GEOREFERENCING_CONVENTION=SPATIAL_PROJ \
            --co BLOCKSIZE="{{ blocksize }},{{ blocksize }}" \
            --co SHARD_CHUNK_SHAPE="{{ chunksize }},{{ chunksize }}" \
            --co COMPRESS="{{ compress }}" \
            "{{ replace(src, 's3://', '/vsis3/') }}" \
            "{{ replace(dst, 's3://', '/vsis3/') }}" \
        && gdal raster overview add \
            --resampling average \
            --levels=2,4,8,16,32 \
            "{{ replace(dst, 's3://', '/vsis3/') }}"
